OPENDOTA_API_KEY=
OPENDOTA_REQUESTS_PER_MINUTE=30
OPENDOTA_REQUESTS_PER_DAY=900
OPENDOTA_CONCURRENCY=2
PORT=3000
ENABLE_HERO_RANKINGS=false
HOST=127.0.0.1
DEV_WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Relative to backend/ when running npm scripts; never commit this database.
DATABASE_PATH=./data/opendota.sqlite
# Integrated server (npm run dev). Enable after configuring exact redirects/origins.
ENABLE_ACCOUNT_FEATURES=false
PUBLIC_BASE_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
AUTH_WEB_REDIRECTS=http://localhost:8081/auth/callback
AUTH_NATIVE_REDIRECTS=opendota://auth/callback
