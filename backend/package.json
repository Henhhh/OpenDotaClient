{
  "name": "opendota-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:steam": "node --env-file-if-exists=.env scripts/check-steam.ts",
    "dev": "node --env-file-if-exists=.env src/server.ts",
    "smoke:part3": "node --env-file-if-exists=.env scripts/smoke-part3.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "test:part3": "node --test tests/part3-*.test.ts",
    "dev:part2": "node --env-file-if-exists=.env src/part2-dev.ts",
    "smoke:part2": "node --env-file-if-exists=.env scripts/smoke-part2.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "lint": "eslint src tests scripts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.7"
  }
}
